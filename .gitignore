# Track the program explicitly; keep shop data and installed builds local.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/HANDOVER.md
!/PackingListApp/
!/V2.0.0/

/PackingListApp/*
!/PackingListApp/src/
!/PackingListApp/qa/
!/PackingListApp/build.ps1
!/PackingListApp/package_runtime.py
!/PackingListApp/README.md
!/PackingListApp/Employee Guide.txt
!/PackingListApp/requirements.txt
!/PackingListApp/requirements-dev.txt

# Keep QA scripts; results, screenshots and copied business files stay local.
/PackingListApp/qa/*
!/PackingListApp/qa/*.py
!/PackingListApp/qa/*.cs

# Retired business-product aliases are not used by the current program.
/PackingListApp/src/assets/picking_aliases.json

**/__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
*.pem
*.key
*.pfx
*.p12
*.log
*.tmp
*.bak
*.bundle
**/ProductNames.json*
**/ProductNames.lock
Thumbs.db
Desktop.ini

# The four sanitized DOCX templates in src/assets ARE tracked.
# Dated source folders and all completed packing documents are excluded
# by the root allowlist above. Back up those business files separately.

!/PackingListApp/Release Notes.txt

# V2 remains runnable Python source; private catalogs and QA outputs stay local.
/V2.0.0/Packing List Manager/
/V2.0.0/Reference/
/V2.0.0/Test Data/
/V2.0.0/PackingListApp/qa/*
!/V2.0.0/PackingListApp/qa/*.py
!/V2.0.0/PackingListApp/qa/*.ps1
/V2.0.0/PackingListApp/src/assets/picking_aliases.json
**/SkuCatalog.json
**/Settings.json
/V2.0.0/Release/
/V2.0.0/PackingListApp/.builddeps/
